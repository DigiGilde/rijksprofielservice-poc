# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rijksprofielservice
POSTGRES_PASSWORD=rijksprofielservice
POSTGRES_DB=rijksprofielservice

# --- OIDC (SSO Rijk realm) ---
OIDC_CLIENT_ID=XXXXXXXXXX
OIDC_CLIENT_SECRET=XXXXXXXXXX
OIDC_DISCOVERY_URL=XXXXXXXXXX

# --- Initial user (bootstrap voor dev) ---
INITIAL_USER_FIRSTNAME=Foo
INITIAL_USER_LASTNAME=Bar
INITIAL_USER_EMAIL=foo.bar@rijksoverheid.nl

# --- Django admin (superuser voor /admin/) ---
DJANGO_SUPERUSER_EMAIL=admin@rijksoverheid.nl
DJANGO_SUPERUSER_PASSWORD=admin

# Auto-login zonder SSO (alleen voor lokale dev)
SKIP_OIDC=true

# --- Machine-to-machine (profielservice realm voor consuming apps) ---
# Issuer-URL en JWKS-URL van de profielservice-realm. In PoC1 mag dit een mock zijn.
PROFIELSERVICE_JWT_ISSUER=http://localhost:8000/mock-issuer
PROFIELSERVICE_JWT_AUDIENCE=profielservice
