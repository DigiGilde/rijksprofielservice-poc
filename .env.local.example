# Alle secrets in dit bestand zijn lokaal-only voor PoC. Niet hergebruiken in productie.

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rijksprofielservice
POSTGRES_PASSWORD=rijksprofielservice
POSTGRES_DB=rijksprofielservice

# --- OIDC (SSO-login via Wies-dev Keycloak realm) ---
# Vul deze waarden aan met de Wies-dev client-gegevens.
OIDC_CLIENT_ID=XXXXXXXXXX
OIDC_CLIENT_SECRET=XXXXXXXXXX
OIDC_DISCOVERY_URL=XXXXXXXXXX

# --- Initial user (bootstrap voor dev) ---
INITIAL_USER_FIRSTNAME=Foo
INITIAL_USER_LASTNAME=Bar
INITIAL_USER_EMAIL=foo.bar@rijksoverheid.nl

# --- Django admin (superuser voor /admin/) ---
DJANGO_SUPERUSER_EMAIL=admin@rijksoverheid.nl
DJANGO_SUPERUSER_PASSWORD=admin

# SKIP_OIDC=true  -> AutoLoginMiddleware, geen Keycloak nodig, snel ontwikkelen.
# SKIP_OIDC=false -> Volle OIDC Authorization Code flow tegen Wies-dev realm.
SKIP_OIDC=true
